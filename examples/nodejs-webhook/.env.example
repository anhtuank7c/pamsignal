# Port for the Express server to listen on
PORT=3000

# Secret token used to authenticate incoming webhook requests from PAMSignal
# You should generate a strong random string for this value.
# Example: openssl rand -hex 32
WEBHOOK_SECRET=your_super_secret_token_here

# --- Optional: TLS / mTLS ---
#
# When TLS_KEY_PATH and TLS_CERT_PATH are set, the server listens on HTTPS
# instead of plain HTTP.
#
# When TLS_REQUIRE_CLIENT_CERT=true, the server enforces mutual TLS — clients
# without a valid cert signed by TLS_CLIENT_CA_PATH are rejected at the
# handshake (before any HTTP request reaches Express). Pair with pamsignal.conf
# webhook_client_cert / webhook_client_key for end-to-end mTLS.
#
# For a local end-to-end demo, run scripts/gen-test-certs.sh to produce a
# matching CA / server cert / client cert set under ./certs/, then point both
# sides at those files.

# TLS_KEY_PATH=./certs/server.key
# TLS_CERT_PATH=./certs/server.crt
# TLS_CLIENT_CA_PATH=./certs/ca.crt
# TLS_REQUIRE_CLIENT_CERT=true
