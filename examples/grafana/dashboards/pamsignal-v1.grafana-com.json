{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "PAMSignal events arrive here via Alloy.",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "logs",
      "name": "Logs",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Brute-force alerts",
        "target": {
          "expr": "{app=\"pamsignal\", event_action=\"brute_force_detected\", host=~\"$host\"}",
          "refId": "Anno"
        }
      }
    ]
  },
  "description": "PAMSignal fleet auth dashboard \u2014 login activity, brute-force detection, and drill-downs by source IP / user.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "PAMSignal on GitHub",
      "url": "https://github.com/anhtuank7c/pamsignal",
      "icon": "external link",
      "tooltip": "Project repository",
      "type": "link",
      "targetBlank": true
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hosts reporting (1h)",
      "description": "Distinct hosts that have emitted at least one PAMSignal event in the last hour.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "count(count by (host) (count_over_time({app=\"pamsignal\", host=~\"$host\"}[1h])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Successful logins",
      "description": "Login successes across the selected hosts and time range.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"pamsignal\", event_action=\"login_success\", host=~\"$host\", service=~\"$service\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": []
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed logins",
      "description": "Login failures across the selected hosts and time range.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"pamsignal\", event_action=\"login_failure\", host=~\"$host\", service=~\"$service\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "mappings": []
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Brute-force alerts",
      "description": "PAMSignal-detected brute-force events across the selected range. Red if non-zero.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"pamsignal\", event_action=\"brute_force_detected\", host=~\"$host\"}[$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": []
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Login attempts/min by outcome",
      "description": "Successful vs failed logins per minute. Sudden vertical spikes in failures are the canonical brute-force signature.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "sum by (event_action) (rate({app=\"pamsignal\", event_action=~\"login_success|login_failure\", host=~\"$host\", service=~\"$service\"}[$__interval]))",
          "legendFormat": "{{event_action}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "cps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "login_success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "login_failure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Brute-force detections by service",
      "description": "Counts of brute_force_detected events grouped by service.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "sum by (service) (rate({app=\"pamsignal\", event_action=\"brute_force_detected\", host=~\"$host\"}[$__interval]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "cps"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Events per host",
      "description": "Top 10 hosts by event volume. Useful to spot a noisy host or one that has fallen silent.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (host) (rate({app=\"pamsignal\", host=~\"$host\", service=~\"$service\", event_action=~\"$action\"}[$__interval])))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "cps"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top source IPs by failed logins (ssh)",
      "description": "Most aggressive sources of failed SSH logins. Drill into the live log panel below to see the underlying events.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (source_ip) (count_over_time({app=\"pamsignal\", event_action=\"login_failure\", service=\"sshd\", host=~\"$host\"} | json source_ip=\"SOURCE_IP\" | source_ip != \"\" [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "source_ip": "Source IP",
              "Value": "Failed attempts"
            },
            "indexByName": {
              "source_ip": 0,
              "Value": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Failed attempts",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed attempts"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Top attacked usernames",
      "description": "Usernames most frequently targeted by failed logins. Dictionary attacks pick on root, admin, ubuntu, oracle, ...",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (user_name) (count_over_time({app=\"pamsignal\", event_action=\"login_failure\", host=~\"$host\", service=~\"$service\"} | json user_name=\"USER_NAME\" | user_name != \"\" [$__range])))",
          "queryType": "instant",
          "refId": "A",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "user_name": "Username",
              "Value": "Failed attempts"
            },
            "indexByName": {
              "user_name": 0,
              "Value": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Failed attempts",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed attempts"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Recent brute-force alerts",
      "description": "PAMSignal-detected brute-force events. These are pre-validated by the daemon's threshold logic.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "{app=\"pamsignal\", event_action=\"brute_force_detected\", host=~\"$host\"} | json source_ip=\"SOURCE_IP\", user_name=\"USER_NAME\" | line_format \"host={{.host}} ip={{.source_ip}} user={{.user_name}} service={{.service}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent successful root logins (ssh)",
      "description": "Successful root logins over SSH. Investigate every one unless this is expected.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "{app=\"pamsignal\", event_action=\"login_success\", service=\"sshd\", host=~\"$host\"} | json user_name=\"USER_NAME\", source_ip=\"SOURCE_IP\" | user_name=\"root\" | line_format \"host={{.host}} ip={{.source_ip}} user=root\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Live event stream",
      "description": "All PAMSignal events for the selected hosts/services/actions. Use the time range and variables above to drill in.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "expr": "{app=\"pamsignal\", host=~\"$host\", service=~\"$service\", event_action=~\"$action\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "pamsignal",
    "auth",
    "ssh",
    "security",
    "brute-force"
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": {
          "label": "host",
          "refId": "host",
          "stream": "{app=\"pamsignal\"}",
          "type": 1
        },
        "definition": "label_values({app=\"pamsignal\"}, host)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": {
          "label": "service",
          "refId": "service",
          "stream": "{app=\"pamsignal\"}",
          "type": 1
        },
        "definition": "label_values({app=\"pamsignal\"}, service)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "action",
        "label": "Event action",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": {
          "label": "event_action",
          "refId": "action",
          "stream": "{app=\"pamsignal\"}",
          "type": 1
        },
        "definition": "label_values({app=\"pamsignal\"}, event_action)",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "1d"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "7d",
      "30d"
    ]
  },
  "timezone": "browser",
  "title": "PAMSignal \u2014 Auth across the fleet",
  "uid": "pamsignal-v1",
  "version": 1,
  "weekStart": ""
}
