# pamsignal configuration
# /etc/pamsignal/pamsignal.conf
#
# Every key is optional. The values shown are the defaults (or, for the
# alert channels, placeholders). Uncomment and change what you need.
# Full reference: man 5 pamsignal.conf
#
# Format: one "key = value" per line. A line starting with # is a comment.
# There are no inline comments (a # after a value is part of the value) and
# values are not quoted. Unknown keys are ignored with a warning; a bad value
# is an error and the daemon refuses to start (a reload keeps the old config).
#
# Reload without restart: sudo systemctl reload pamsignal
# Validate after editing:  sudo -u pamsignal pamsignal --check-config
# Send a test alert:       sudo -u pamsignal pamsignal --test-alert
#
# This file may contain alert credentials. It must be owned by root or the
# pamsignal user and must not be group- or world-writable.
# Recommended permissions: root:pamsignal 0640

# --- Brute-force detection ---
# Failed attempts (per source IP, or per local actor for sudo/su) within
# fail_window_sec that trigger a brute-force alert. Range 1..10000.
# fail_threshold = 5
# Window in seconds. Range 1..86400.
# fail_window_sec = 300
# Distinct IPs / local actors tracked at once; when full, the least
# recently active entry is replaced. Range 1..100000.
# max_tracked_ips = 256

# --- Alert rate limiting ---
# Seconds before the same alert is sent again. Range 0..86400; 0 = no limit.
# Brute-force and login-after-failures alerts are limited per source.
# All other per-event alerts (login_success, login_failed, session_open,
# session_close) are limited per event type, user and source IP: repeats
# of the same key go to the journal only; other users and IPs alert at once.
# alert_cooldown_sec = 60

# --- Login-after-failures detection ---
# A successful login from an IP that has just failed at least this many
# times (within fail_window_sec) is flagged as a likely guessed password
# with a [CRIT] alert. Range 0..10000; 0 disables it.
# success_after_fail_threshold = 3

# --- Trusted sources ---
# Comma-separated IPv4/IPv6 addresses or CIDR networks (office, VPN,
# bastion; at most 32; prefix length 1 or more) whose routine
# login_success / login_failed chat alerts are muted. Brute-force and
# login-after-failures alerts still fire for them, session events are not
# affected, and the journal still records every event. Default: empty.
# Example:
#   trusted_sources = 10.0.0.0/8, 203.0.113.7, 2001:db8::/32
# trusted_sources =

# --- Chat-dispatch filter ---
# Comma-separated list of event categories that fire a chat alert.
# Valid tokens: login_success, login_failed, session_open, session_close,
# brute_force, login_after_failures, all (case-insensitive).
# Default: all. An explicit list must name login_after_failures to receive
# that alert. Filters only the chat channels and the webhook; the local
# journal (journalctl -t pamsignal) still records every event.
# Example:
#   enable_notification_type = login_success,brute_force,login_after_failures
# enable_notification_type = all

# --- Chat message layout ---
#   compact  one line of key=value text (default)
#   pretty   multi-line, with bold labels and monospace values in each
#            platform's own markup (Telegram, Slack, WhatsApp, Discord; Teams
#            gets an Adaptive Card)
# The custom webhook's JSON payload is the same in both styles.
# Preview either style with:  sudo -u pamsignal pamsignal --test-alert
# message_style = compact

# --- Context tags (optional) ---
# Free text (at most 63 characters each), added to every alert so you can
# tell servers apart. Default: empty.
# provider = aws
# service_name = web-api

# --- Alert channels (optional) ---
# Only configure the channels you use; an empty value disables a channel.
# Alerts are fire-and-forget: a failed delivery never stops monitoring.
# URLs must start with https://.

# Telegram (token from @BotFather; chat ID is a number or @channelname)
# telegram_bot_token = <bot_token>
# telegram_chat_id = <chat_id>

# Slack
# slack_webhook_url = <webhook_url>

# Microsoft Teams: a Workflows webhook URL (channel ... menu > Workflows >
# "Send webhook alerts to a channel"). Office 365 connector URLs no longer work.
# teams_webhook_url = <webhook_url>

# WhatsApp (Meta Cloud API; phone number ID and recipient are digits only)
# whatsapp_access_token = <access_token>
# whatsapp_phone_number_id = <phone_number_id>
# whatsapp_recipient = <recipient_number>

# Discord
# discord_webhook_url = <webhook_url>

# Custom webhook (receives an ECS JSON POST, see docs/alerts.md)
# webhook_url = <webhook_url>
# Optional auth header sent with the custom webhook POST. Full
# "Name: value" form so any header works (Bearer, API keys, HMAC).
# The secret stays out of /proc/<pid>/cmdline (passed to curl via memfd).
# webhook_auth_header = Authorization: Bearer <token>
#
# Optional mTLS client authentication for the custom webhook. Path values,
# not inline PEM. Cert and key must be set together; the CA bundle is
# optional (only needed if the receiver's CA isn't in the system trust
# store). Files must be regular files (no symlinks) owned by root or the
# pamsignal user; the daemon refuses to start if the key file is group- or
# world-readable.
# webhook_client_cert = /etc/pamsignal/webhook-client.crt
# webhook_client_key  = /etc/pamsignal/webhook-client.key
# webhook_ca_bundle   = /etc/pamsignal/webhook-ca.pem
