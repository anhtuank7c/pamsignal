# pamsignal configuration
# /etc/pamsignal/pamsignal.conf
#
# All values shown are defaults. Uncomment and change as needed.
# Reload without restart: sudo systemctl reload pamsignal
#
# This file may contain alert credentials.
# Recommended permissions: root:pamsignal 0640

# Brute-force detection
# fail_threshold = 5
# fail_window_sec = 300
# max_tracked_ips = 256

# --- Context tags (optional) ---
# Add metadata to your alerts to easily identify the server environment
# provider = aws
# service_name = web-api

# Alert rate limiting
# alert_cooldown_sec = 60

# Chat-dispatch filter. Comma-separated list of event categories that
# should fire a chat alert. Default = all five (preserves prior behaviour).
# Valid tokens: login_success, login_failed, session_open, session_close,
# brute_force, all. Filters only the chat channels; the local journal
# (journalctl -t pamsignal) still records every event.
# Examples:
#   enable_notification_type = login_success,brute_force
#   enable_notification_type = all
# enable_notification_type = all

# --- Alert channels (optional, best-effort) ---
# Only configure the channels you use.
# Alerts are fire-and-forget — failures won't break monitoring.

# Telegram
# telegram_bot_token = <bot_token>
# telegram_chat_id = <chat_id>

# Slack
# slack_webhook_url = <webhook_url>

# Microsoft Teams
# teams_webhook_url = <webhook_url>

# WhatsApp (Meta Cloud API)
# whatsapp_access_token = <access_token>
# whatsapp_phone_number_id = <phone_number_id>
# whatsapp_recipient = <recipient_number>

# Discord
# discord_webhook_url = <webhook_url>

# Custom webhook (receives JSON POST, see docs/alerts.md)
# webhook_url = <webhook_url>
# Optional auth header sent with the custom webhook POST. Full
# "Name: value" form so any header works (Bearer, API keys, HMAC).
# Secret stays out of /proc/<pid>/cmdline (passed via memfd to curl).
# webhook_auth_header = Authorization: Bearer <token>
#
# Optional mTLS client authentication for the custom webhook. Path values,
# not inline PEM — manage via your cert pipeline (cert-manager, certbot,
# systemd-creds). Cert and key must be set together; CA bundle is optional
# (only needed if the receiver's CA isn't in the system trust store).
# Daemon refuses to start if the key file is group/world-readable.
# webhook_client_cert = /etc/pamsignal/webhook-client.crt
# webhook_client_key  = /etc/pamsignal/webhook-client.key
# webhook_ca_bundle   = /etc/pamsignal/webhook-ca.pem
